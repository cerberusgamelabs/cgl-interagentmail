include README.md
include SYSTEM.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include SECURITY.md
include pyproject.toml
recursive-include docs *.md
recursive-include scripts *.ps1
recursive-include tests *.py
prune .agents
prune .codex
prune .git
prune .venv
prune build
prune chats
prune DEV
prune dist
prune InterAgentChatReader
prune mailboxes
prune run
prune reports
prune skills
exclude config.json
exclude InterAgentChatReader.zip
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
