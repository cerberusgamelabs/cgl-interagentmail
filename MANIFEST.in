include README.md
include SYSTEM.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include SECURITY.md
include pyproject.toml
recursive-include docs *.md
recursive-include scripts *.ps1
include scripts/audit_mobile_apk.py
include scripts/check_installed_modules.py
include scripts/check_python_regression.py
recursive-include tests *.py
recursive-include desktop *.cjs *.json *.html *.css *.js
recursive-include desktop/assets *.png *.ico
recursive-include desktop/public/emoji *.png *.txt
exclude docs/DESKTOP_099_READINESS.md
exclude docs/MOBILE_099_ACCEPTANCE.md
prune artifacts
prune desktop/node_modules
prune .agents
prune .codex
prune .git
prune .venv
prune build
prune chats
prune attachments
prune teams
prune hooks
prune orphaned-mailboxes
prune DEV
prune dist
prune InterAgentChatReader
prune mailboxes
prune run
prune reports
prune skills
exclude config.json
exclude web.json
exclude webconnect.json
exclude webconnect-state.json
exclude .env
exclude .env.*
exclude InterAgentChatReader.zip
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
